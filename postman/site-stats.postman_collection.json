{
  "info": {
    "name": "Site stats - GitHub API contract checks",
    "description": "The live checks behind scripts/site-stats.mjs. Generated by scripts/build-postman.mjs. Run with Newman: see the README section \"API and contract tests for the site totals\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.github.com"
    },
    {
      "key": "repo",
      "value": "srjohnson1986/srjohnson1986.github.io"
    }
  ],
  "item": [
    {
      "name": "Repository",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/repos/{{repo}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"object\",\"required\":[\"full_name\",\"default_branch\"],\"properties\":{\"full_name\":{\"type\":\"string\",\"pattern\":\"^[^/]+/[^/]+$\"},\"default_branch\":{\"type\":\"string\",\"minLength\":1}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "pm.test('it is the repository we asked for', () => pm.expect(json.full_name.toLowerCase()).to.eql(pm.variables.get('repo').toLowerCase()));",
              "pm.test('the default branch is main', () => pm.expect(json.default_branch).to.eql('main'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Issues (search)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/search/issues?q=repo%3A{{repo}}%20type%3Aissue&per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"object\",\"required\":[\"total_count\",\"incomplete_results\"],\"properties\":{\"total_count\":{\"type\":\"integer\",\"minimum\":0},\"incomplete_results\":{\"type\":\"boolean\"}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "const count = json.total_count;",
              "pm.collectionVariables.set('count_issues', count);",
              "pm.test('the count is a non-negative integer', () => { pm.expect(Number.isInteger(count)).to.be.true; pm.expect(count).to.be.at.least(0); });",
              "pm.test('the search is complete', () => pm.expect(json.incomplete_results).to.be.false);",
              "const min = pm.variables.get('min_issues');",
              "pm.test('not lower than the committed value (min_issues)', function () { if (min === undefined || min === '') this.skip(); pm.expect(count).to.be.at.least(Number(min)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Pull requests (search)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/search/issues?q=repo%3A{{repo}}%20type%3Apr&per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"object\",\"required\":[\"total_count\",\"incomplete_results\"],\"properties\":{\"total_count\":{\"type\":\"integer\",\"minimum\":0},\"incomplete_results\":{\"type\":\"boolean\"}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "const count = json.total_count;",
              "pm.collectionVariables.set('count_pull_requests', count);",
              "pm.test('the count is a non-negative integer', () => { pm.expect(Number.isInteger(count)).to.be.true; pm.expect(count).to.be.at.least(0); });",
              "pm.test('the search is complete', () => pm.expect(json.incomplete_results).to.be.false);",
              "const min = pm.variables.get('min_pull_requests');",
              "pm.test('not lower than the committed value (min_pull_requests)', function () { if (min === undefined || min === '') this.skip(); pm.expect(count).to.be.at.least(Number(min)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Merged pull requests (search)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/search/issues?q=repo%3A{{repo}}%20type%3Apr%20is%3Amerged&per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"object\",\"required\":[\"total_count\",\"incomplete_results\"],\"properties\":{\"total_count\":{\"type\":\"integer\",\"minimum\":0},\"incomplete_results\":{\"type\":\"boolean\"}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "const count = json.total_count;",
              "pm.collectionVariables.set('count_pull_requests_merged', count);",
              "pm.test('the count is a non-negative integer', () => { pm.expect(Number.isInteger(count)).to.be.true; pm.expect(count).to.be.at.least(0); });",
              "pm.test('the search is complete', () => pm.expect(json.incomplete_results).to.be.false);",
              "const min = pm.variables.get('min_pull_requests_merged');",
              "pm.test('not lower than the committed value (min_pull_requests_merged)', function () { if (min === undefined || min === '') this.skip(); pm.expect(count).to.be.at.least(Number(min)); });",
              "pm.test('merged pull requests do not exceed all pull requests', () => pm.expect(count).to.be.at.most(Number(pm.collectionVariables.get('count_pull_requests'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Commits (first page)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/repos/{{repo}}/commits?per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"sha\"],\"properties\":{\"sha\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{40}$\"}}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "const count = lastPage(pm.response.headers.get('Link')) ?? json.length;",
              "pm.collectionVariables.set('count_commits', count);",
              "pm.test('the count is a non-negative integer', () => { pm.expect(Number.isInteger(count)).to.be.true; pm.expect(count).to.be.at.least(0); });",
              "pm.test('the commit list is not empty', () => pm.expect(json).to.have.length.above(0));",
              "const min = pm.variables.get('min_commits');",
              "pm.test('not lower than the committed value (min_commits)', function () { if (min === undefined || min === '') this.skip(); pm.expect(count).to.be.at.least(Number(min)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Releases (first page)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2022-11-28"
          }
        ],
        "url": "{{base_url}}/repos/{{repo}}/releases?per_page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lastPage = (link) => { const m = /[?&]page=(\\d+)[^>]*>;\\s*rel=\"last\"/.exec(link || ''); return m ? Number(m[1]) : null; };",
              "const schema = {\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"tag_name\"],\"properties\":{\"tag_name\":{\"type\":\"string\",\"minLength\":1}}}};",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response matches the contract', () => pm.response.to.have.jsonSchema(schema));",
              "const json = pm.response.json();",
              "const count = lastPage(pm.response.headers.get('Link')) ?? json.length;",
              "pm.collectionVariables.set('count_releases', count);",
              "pm.test('the count is a non-negative integer', () => { pm.expect(Number.isInteger(count)).to.be.true; pm.expect(count).to.be.at.least(0); });",
              "const min = pm.variables.get('min_releases');",
              "pm.test('not lower than the committed value (min_releases)', function () { if (min === undefined || min === '') this.skip(); pm.expect(count).to.be.at.least(Number(min)); });"
            ]
          }
        }
      ]
    }
  ]
}
