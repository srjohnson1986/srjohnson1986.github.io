{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site-stats.schema.json",
  "title": "src/data/site-stats.json - the project totals written by scripts/site-stats.mjs",
  "type": "object",
  "required": ["generated", "repo", "issues", "pull_requests", "pull_requests_merged", "commits", "releases", "lines_of_code", "playwright_tests", "spec_files"],
  "additionalProperties": false,
  "properties": {
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "issues": { "type": "integer", "minimum": 0 },
    "pull_requests": { "type": "integer", "minimum": 0 },
    "pull_requests_merged": { "type": "integer", "minimum": 0 },
    "commits": { "type": "integer", "minimum": 1 },
    "releases": { "type": "integer", "minimum": 0 },
    "lines_of_code": { "type": "integer", "minimum": 1 },
    "playwright_tests": { "type": "integer", "minimum": 1 },
    "spec_files": { "type": "integer", "minimum": 1 }
  }
}
