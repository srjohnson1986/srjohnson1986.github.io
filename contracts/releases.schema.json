{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "releases.schema.json",
  "title": "GET /repos/{owner}/{repo}/releases - a list; an empty list means no releases yet",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tag_name"],
    "properties": { "tag_name": { "type": "string", "minLength": 1 } }
  }
}
