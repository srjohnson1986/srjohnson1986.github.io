---
// Self-hosted font files (latin subset, three weights). Astro bundles them into the build, so the
// site never asks Google Fonts or any other third party for a font.
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-600.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
// The same three files as a URL, to preload them (see the <link rel="preload"> tags below). They are
// imported by path because the package does not export its font files by name. Vite gives each file one
// hashed address, so these links and the url() in the CSS above point at the same file.
import font400 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';
import font600 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-600-normal.woff2?url';
import font700 from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-700-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Keeps a page out of search results (used by the print routes). */
  noindex?: boolean;
  /** Preview image for link cards, as a path on this site. Defaults to the shared preview image. */
  image?: string;
  /** 'light' pins the page to a white background regardless of the viewer's theme. */
  theme?: 'auto' | 'light';
  /** Extra class on <body>, for page-specific styling. */
  bodyClass?: string;
  /** Print routes pass false: no skip link, header, footer, or page container, only the content. */
  chrome?: boolean;
}

const { title, description, noindex = false, image = '/images/social-preview.jpg', theme = 'auto', bodyClass, chrome = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const imageUrl = new URL(image, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en" data-theme={theme === 'light' ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {
      chrome && (
        <script is:inline>
          /* Apply a saved theme choice before the page paints, so there is no flash of the other theme. */
          try {
            var t = localStorage.getItem('theme');
            if ((t === 'light' || t === 'dark') && !document.documentElement.hasAttribute('data-theme')) {
              document.documentElement.setAttribute('data-theme', t);
            }
          } catch (e) {}
        </script>
      )
    }
    {/* Without these, the browser only finds the fonts after the stylesheet has loaded, so it draws the text in a
        fallback font first and the page jumps when Atkinson swaps in (a layout shift of 0.12 on the Resume page
        on a Linux runner). `crossorigin` is required even for fonts from this site: fonts are always fetched
        in anonymous CORS mode, and a preload without it would be fetched a second time. */}
    {[font400, font600, font700].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, waving hello`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class={bodyClass}>
    {chrome && <a class="skip-link" href="#main">Skip to content</a>}
    {
      chrome ? (
        <div class="site-shell container">
          <SiteHeader />
          <main id="main">
            <slot />
          </main>
          <SiteFooter />
        </div>
      ) : (
        <main id="main">
          <slot />
        </main>
      )
    }
  </body>
</html>
