---
import { nav, site, type NavItem } from '../data/site';

const path = Astro.url.pathname;
// Home matches only "/"; every other entry also matches its sub-pages (/resume/qa/ is "Resume").
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// The phone menu keeps ungrouped links where they are and lists items that share a group
// together, under the group's name, at the position of the group's first item.
type Entry = { kind: 'link'; item: NavItem } | { kind: 'group'; label: string; items: NavItem[] };
const entries: Entry[] = [];
for (const item of nav) {
  if (!item.group) {
    entries.push({ kind: 'link', item });
    continue;
  }
  let group = entries.find((e): e is Extract<Entry, { kind: 'group' }> => e.kind === 'group' && e.label === item.group);
  if (!group) {
    group = { kind: 'group', label: item.group, items: [] };
    entries.push(group);
  }
  group.items.push(item);
}
---

<header class="site-header no-print">
  <a class="brand" href="/">{site.name}</a>

  <!-- Wide screens: every link in one row. -->
  <nav class="nav-wide" aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Phones: one Menu button. The native details element gives keyboard and screen reader
       support with no script. -->
  <details class="nav-menu">
    <summary>Menu</summary>
    <nav aria-label="Main">
      <ul>
        {
          entries.map((entry) =>
            entry.kind === 'link' ? (
              <li>
                <a href={entry.item.href} aria-current={isCurrent(entry.item.href) ? 'page' : undefined}>
                  {entry.item.label}
                </a>
              </li>
            ) : (
              <li class="group">
                <span class="group-label">{entry.label}</span>
                <ul>
                  {entry.items.map((item) => (
                    <li>
                      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </details>

  <!-- Needs JavaScript, so it stays hidden until the script below shows it. Without JavaScript the
       page follows the visitor's system theme. -->
  <!-- A small picture of the theme that is on now: a sun in a blue sky for light, a moon among stars
       for dark. The aria-label names the theme a click switches to, and the picture is hidden from
       screen readers. The shapes are drawn here (no icon library), and the stylesheet below moves
       the sun, grows the moon from it, and fades the sky. -->
  <button class="theme-toggle" type="button" hidden>
    <svg class="scene" aria-hidden="true" focusable="false" viewBox="0 0 58 30" preserveAspectRatio="xMidYMid slice">
      <defs>
        <!-- The moon is the sun's disc with a second disc cut out of it. -->
        <mask id="theme-moon-cut" maskUnits="userSpaceOnUse" x="-14" y="-14" width="28" height="28">
          <rect x="-14" y="-14" width="28" height="28" fill="#fff"></rect>
          <circle class="cut" cx="2.6" cy="-1.9" r="6" fill="#000"></circle>
        </mask>
      </defs>
      <rect class="sky" width="58" height="30"></rect>
      <g class="stars">
        <circle cx="8" cy="8" r="1"></circle>
        <circle cx="15" cy="22" r="0.8"></circle>
        <circle cx="21" cy="9" r="0.7"></circle>
        <circle cx="12" cy="15" r="0.6"></circle>
        <circle cx="25" cy="19" r="0.9"></circle>
      </g>
      <g transform="translate(15 15)">
        <g class="knob">
          <g class="rays">
            <path d="M0 -9.5V-12"></path>
            <path d="M0 -9.5V-12" transform="rotate(45)"></path>
            <path d="M0 -9.5V-12" transform="rotate(90)"></path>
            <path d="M0 -9.5V-12" transform="rotate(135)"></path>
            <path d="M0 -9.5V-12" transform="rotate(180)"></path>
            <path d="M0 -9.5V-12" transform="rotate(225)"></path>
            <path d="M0 -9.5V-12" transform="rotate(270)"></path>
            <path d="M0 -9.5V-12" transform="rotate(315)"></path>
          </g>
          <circle class="core" r="6.5" mask="url(#theme-moon-cut)"></circle>
        </g>
      </g>
    </svg>
  </button>
</header>

<script>
  // The theme button switches between light and dark and remembers the choice. Until it is used,
  // the page follows the system setting.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) {
    const root = document.documentElement;
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    const current = () => root.dataset.theme ?? (system.matches ? 'dark' : 'light');
    const other = () => (current() === 'dark' ? 'light' : 'dark');

    const render = () => {
      // The picture follows the theme that is on now. The label names the one a click switches to.
      button.dataset.mode = current();
      button.setAttribute('aria-label', `Switch to ${other()} theme`);
    };

    // Set the picture while the button is still hidden, so it does not animate in on page load.
    render();
    button.hidden = false;

    button.addEventListener('click', () => {
      const next = other();
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage can be blocked. The choice then lasts until the page is closed.
      }
      render();
    });

    // While no choice has been made, the button follows a change in the system setting.
    system.addEventListener('change', render);
  }
</script>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .brand {
    color: var(--fg);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-wide ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  a {
    display: inline-block;
    padding: 0.25rem 0;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  a:hover {
    color: var(--fg);
  }

  a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }

  /* The theme button is a small scene. Light: an orange sun in a soft blue sky. Dark: a pale moon
     among stars. The sun slides across and becomes the moon while the sky fades. The orange is a
     deep one on purpose: a brighter orange on a pastel blue falls below 3:1 contrast, and the sun
     and moon need to stay easy to tell apart. */
  .theme-toggle {
    --sky: #cfe6ff;
    --body: #d9480f;
    --edge: #9dc3ee;
    box-sizing: border-box;
    align-self: center;
    width: 3.75rem;
    height: 2rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: var(--sky);
    cursor: pointer;
    transition:
      border-color 0.4s,
      background-color 0.4s;
  }

  .theme-toggle[data-mode='dark'] {
    --sky: #2b3040;
    --body: #e8e2c4;
    --edge: #4a5070;
  }

  .theme-toggle:hover {
    border-color: var(--body);
  }

  .theme-toggle:focus-visible {
    outline-offset: 2px;
  }

  .scene {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sky {
    fill: var(--sky);
    transition: fill 0.4s;
  }

  .stars {
    fill: #f4f1de;
    opacity: 0;
    transition: opacity 0.25s;
  }

  .knob {
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .rays {
    fill: none;
    stroke: var(--body);
    stroke-width: 1.6;
    stroke-linecap: round;
    transition:
      transform 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s,
      stroke 0.4s;
  }

  .core {
    fill: var(--body);
    transition: fill 0.4s;
  }

  /* The cut-out disc waits off to the side in light, and slides over the sun in dark. */
  .cut {
    transform: translate(16px, -16px);
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-toggle[data-mode='dark'] .knob {
    transform: translateX(28px);
  }

  .theme-toggle[data-mode='dark'] .rays {
    opacity: 0;
    transform: rotate(45deg) scale(0.4);
  }

  .theme-toggle[data-mode='dark'] .cut {
    transform: none;
  }

  .theme-toggle[data-mode='dark'] .stars {
    opacity: 1;
    transition-delay: 0.2s;
  }

  /* With reduced motion the scene changes at once. */
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle * {
      transition: none;
    }
  }

  /* ---- Phone menu ---- */
  .nav-menu summary {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 0.4rem;
    background: var(--card);
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary::after {
    content: ' \25BE';
    color: var(--muted);
  }

  .nav-menu[open] summary::after {
    content: ' \25B4';
  }

  /* The open menu floats under the header so the page does not jump. */
  .nav-menu nav {
    position: absolute;
    top: calc(100% - 0.4rem);
    right: 0;
    z-index: 5;
    min-width: 13rem;
    padding: 0.5rem 0.9rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    background: var(--card);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
  }

  .nav-menu nav > ul > li {
    margin: 0.15rem 0;
  }

  .group-label {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .group ul {
    margin-left: 0.75rem;
  }

  /* Wide screens use the single row, phones use the menu. The hidden one is removed from the
     page entirely, so screen readers only meet one navigation. */
  @media (min-width: 40rem) {
    .nav-menu {
      display: none;
    }
  }

  @media (max-width: 39.99rem) {
    .nav-wide {
      display: none;
    }

    .site-header {
      align-items: center;
    }
  }
</style>
