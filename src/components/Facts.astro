---
// A strip of headline numbers. Used on project pages and the Events page.
interface Props {
  facts: { value: string; label: string }[];
  label?: string;
}

const { facts, label = 'Headline facts' } = Astro.props;
---

<ul class="facts" aria-label={label}>
  {
    facts.map((fact) => (
      <li>
        <strong>{fact.value}</strong>
        <span>{fact.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: var(--card);
  }

  strong {
    display: block;
    color: var(--accent);
    font-size: 1.3rem;
    line-height: 1.2;
  }

  span {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
