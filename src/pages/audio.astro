---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveFilters, { type Facet } from '../components/ArchiveFilters.astro';
import { getReleases, getFacets, embedFor, TYPE_LABELS, ROLE_LABELS } from '../lib/audio';
import { tagLabel } from '../lib/projects';
import { site } from '../data/site';

const releases = await getReleases();
const facets = getFacets(releases);
const [studio] = await getCollection('studio');

const filterFacets: Facet[] = [
  {
    kind: 'select',
    name: 'year',
    label: 'Year',
    allLabel: 'All years',
    options: facets.years.map((year) => ({ value: String(year), label: String(year) })),
  },
  {
    kind: 'select',
    name: 'role',
    label: 'My role',
    allLabel: 'Any role',
    options: facets.roles.map((r) => ({ value: r.role, label: `${r.label} (${r.count})` })),
  },
  {
    kind: 'tags',
    name: 'tag',
    legend: 'Genres (a release must have every tag you pick)',
    options: facets.tags.map((t) => ({ value: t.tag, label: `${t.label} (${t.count})` })),
  },
];
---

<BaseLayout
  title={`Audio | ${site.name}`}
  description="Recordings made at Kingdom Hell, my home studio: production and engineering for other artists, with a player for each release."
>
  <h1>Audio</h1>
  <p class="lead">
    Recordings made at Kingdom Hell, my home studio, mostly production and engineering for other
    artists. The roles shown are the ones credited to me on each release's Bandcamp page, where
    the full credits are.
  </p>
  {
    studio && (
      <section class="story" aria-label="About the studio">
        {studio.data.story.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    )
  }

  {
    studio && (
      <p class="studio-link">
        Looking to record? <a href="#studio">Rates and how to prepare</a> are at the bottom of the
        page.
      </p>
    )
  }

  {
    releases.length === 0 ? (
      <p class="empty">Releases are on the way. Recordings made at Kingdom Hell will appear here.</p>
    ) : (
      <ArchiveFilters
        facets={filterFacets}
        noun="releases"
        emptyMessage="No releases match these filters. Try removing one."
      >
        <ul class="release-list">
          {releases.map((release) => (
            <li
              class="release"
              data-item
              data-year={release.data.year}
              data-role={(release.data.roles ?? []).join(' ')}
              data-tag={release.data.tags.join(' ')}
            >
              <h2>{release.data.title}</h2>
              <p class="artist">{release.data.artist}</p>
              <p class="meta">
                {release.data.year} &middot; {TYPE_LABELS[release.data.type]}
                {release.data.roles && (
                  <>
                    {' '}
                    &middot; My role: {release.data.roles.map((role) => ROLE_LABELS[role]).join(', ')}
                  </>
                )}
              </p>
              <ul class="chips">
                {release.data.tags.map((tag) => <li class="chip">{tagLabel(tag)}</li>)}
              </ul>
              <div class="player">
                {
                  release.data.embed && (
                    <>
                      {/* Two copies, one per theme. CSS shows the one that matches the page, and the
                          hidden one is lazy, so the browser never fetches it. */}
                      <iframe
                        class="embed-light"
                        src={embedFor(release.data.embed, 'light')}
                        title={`Bandcamp player: ${release.data.title} by ${release.data.artist}`}
                        loading="lazy"
                        height={release.data.embedHeight ?? 120}
                      />
                      <iframe
                        class="embed-dark"
                        src={embedFor(release.data.embed, 'dark')}
                        title={`Bandcamp player: ${release.data.title} by ${release.data.artist}`}
                        loading="lazy"
                        height={release.data.embedHeight ?? 120}
                      />
                    </>
                  )
                }
              </div>
            </li>
          ))}
        </ul>
      </ArchiveFilters>
    )
  }

  {
    studio && (
      <section id="studio" class="studio" aria-labelledby="studio-heading">
        <h2 id="studio-heading">{studio.data.heading}</h2>
        <ul class="rates">
          {studio.data.rates.map((rate) => (
            <li>
              <strong>{rate.price}</strong> {rate.description}
            </li>
          ))}
        </ul>
        <p>{studio.data.included}</p>

        <h3>{studio.data.prep.heading}</h3>
        <p>{studio.data.prep.intro}</p>
        <ul class="prep">
          {studio.data.prep.steps.map((step) => <li>{step}</li>)}
        </ul>

        <p class="book">
          To ask about booking, use the <a href="/contact/">contact page</a>.
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .lead,
  .empty {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .story {
    max-width: 42rem;
    margin: 0 0 1.5rem;
  }

  .story p {
    margin: 0 0 0.8rem;
  }

  .studio-link {
    margin: -0.75rem 0 1.5rem;
    font-size: 0.95rem;
  }

  .studio {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .studio h2 {
    margin: 0 0 0.75rem;
    font-size: 1.4rem;
  }

  .studio h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1rem;
  }

  .studio p {
    margin: 0.75rem 0 0;
  }

  .rates,
  .prep {
    margin: 0;
    padding-left: 1.2rem;
  }

  .rates {
    list-style: none;
    padding-left: 0;
  }

  .rates li {
    margin-bottom: 0.3rem;
  }

  .rates strong {
    color: var(--accent);
  }

  .prep li {
    margin-bottom: 0.45rem;
  }

  .release-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: var(--card);
  }

  .release h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .release p {
    margin: 0;
  }

  .artist {
    font-weight: 600;
  }

  .release .meta {
    margin: 0.15rem 0 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .release .chips {
    margin-bottom: 0.8rem;
  }

  /* The Bandcamp player is drawn from the colors in its address, so each release has a light and a
     dark copy and the page shows the one for the current theme: the dark one when the visitor chose
     dark, or when no choice was made and the system is dark. */
  .player iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  .embed-dark {
    display: none !important;
  }

  :global(:root[data-theme='dark']) .embed-light {
    display: none !important;
  }

  :global(:root[data-theme='dark']) .embed-dark {
    display: block !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .embed-light {
      display: none !important;
    }

    :global(:root:not([data-theme])) .embed-dark {
      display: block !important;
    }
  }
</style>
