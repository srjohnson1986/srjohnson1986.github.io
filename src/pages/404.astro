---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { getNav } from '../lib/nav';
import { fill } from '../lib/copy';

const text = (await getEntry('intros', 'not-found'))!.data;

// GitHub Pages serves this file, with a 404 status, for any address the site does not have.
// Grouped the way the header groups them: a section, then the pages under it. Home is left out, since the button above goes there.
const sections = (await getNav()).filter((item) => item.href !== '/');
---

<BaseLayout
  title={fill(text.title)}
  description={fill(text.description)}
  noindex
>
  <h1>{text.heading}</h1>
  <p class="lead">{text.lead}</p>

  <p>
    <a class="button" href="/">{text.button}</a>
  </p>

  <h2>{text.links_heading}</h2>
  <ul class="sections">
    {
      sections.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
          {item.children && (
            <ul>
              {item.children.map((child) => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .lead {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  h2 {
    margin: 2rem 0 0.5rem;
    font-size: 1.2rem;
  }

  .sections,
  .sections ul {
    margin: 0;
    padding-left: 1.2rem;
  }
</style>
