---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArtworks, groupByMedium, FORMAT_LABELS, type Artwork } from '../lib/art';
import { site } from '../data/site';

const intro = (await getEntry('intros', 'art'))!.data;
const pieces = await getArtworks();
const groups = groupByMedium(pieces);

// "2026.02.13 · Social media", "2025 · Square", or just the shape when there is no date.
const metaOf = (piece: Artwork) =>
  [piece.data.date ?? piece.data.year, piece.data.format && FORMAT_LABELS[piece.data.format]]
    .filter(Boolean)
    .join(' · ');

// The larger version shown when an image is clicked: up to 2400 px wide, never bigger than the
// original (so a small original is not blown up), as WebP to keep the big PNGs light.
const largeOf = async (image: ImageMetadata) =>
  (await getImage({ src: image, width: Math.min(image.width, 2400), format: 'webp', quality: 85 })).src;

const large = new Map<string, string>();
for (const piece of pieces) {
  large.set(piece.id, await largeOf(piece.data.image));
  for (const [i, extra] of (piece.data.more ?? []).entries()) large.set(`${piece.id}#${i}`, await largeOf(extra.image));
}

// What the expand and collapse control says, depending on what is inside it.
const detailsLabel = (piece: Artwork) => {
  const extra = piece.data.more?.length ?? 0;
  const hasText = Boolean(piece.data.story || piece.data.caption);
  if (hasText && extra) return `Read more and ${extra} more image${extra === 1 ? '' : 's'}`;
  if (extra) return `${extra} more image${extra === 1 ? '' : 's'}`;
  return 'Read more';
};
---

<BaseLayout
  title={`Art | ${site.name}`}
  description="Show flyers and other art made in Procreate, with the story behind each piece."
>
  <h1>Art</h1>
  <p class="lead">{intro.lead}</p>

  <section class="statement" aria-label="About my flyers">
    {intro.paragraphs!.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  {
    groups.length === 0 ? (
      <p class="empty">
        Artwork is on the way. Show flyers and other Procreate work will appear here.
      </p>
    ) : (
      groups.map((group) => (
        <section
          class="group"
          aria-label={groups.length > 1 ? undefined : group.label}
          aria-labelledby={groups.length > 1 ? `group-${group.medium}` : undefined}
        >
          {/* With a single group a heading adds nothing, so it is only shown when there are several. */}
          {groups.length > 1 && <h2 id={`group-${group.medium}`}>{group.label}</h2>}
          <ul class="gallery">
            {group.pieces.map((piece) => (
              <li>
                <figure class="piece">
                  <a class="zoom" href={large.get(piece.id)} data-lightbox data-title={piece.data.title} aria-label={`View larger: ${piece.data.title}`}>
                    <Image
                      src={piece.data.image}
                      alt={piece.data.alt}
                      widths={[320, 480, 640, 960]}
                      sizes="(max-width: 36rem) 100vw, 15rem"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <figcaption>
                    <strong>{piece.data.title}</strong>
                    {metaOf(piece) && <span class="meta">{metaOf(piece)}</span>}
                  </figcaption>
                  {!(piece.data.story || piece.data.more || piece.data.caption) && <div class="read-more-space" aria-hidden="true" />}
                  {(piece.data.story || piece.data.more || piece.data.caption) && (
                    <details>
                      <summary>{detailsLabel(piece)}</summary>
                      {piece.data.caption && <p class="caption">{piece.data.caption}</p>}
                      {piece.data.story?.map((paragraph) => <p>{paragraph}</p>)}
                      {piece.data.more && (
                        <ul class="more">
                          {piece.data.more.map((extra, i) => (
                            <li>
                              <figure>
                                <a
                                  class="zoom"
                                  href={large.get(`${piece.id}#${i}`)}
                                  data-lightbox
                                  data-title={piece.data.title}
                                  aria-label={`View larger: ${piece.data.title}, image ${i + 2}`}
                                >
                                  <Image
                                    src={extra.image}
                                    alt={extra.alt}
                                    widths={[240, 360, 480, 720]}
                                    sizes="(max-width: 36rem) 50vw, 7rem"
                                    loading="lazy"
                                    decoding="async"
                                  />
                                </a>
                                {extra.caption && <figcaption>{extra.caption}</figcaption>}
                              </figure>
                            </li>
                          ))}
                        </ul>
                      )}
                    </details>
                  )}
                </figure>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>

<script>
  // Cards in a row end at the same place. The title and date under each image can wrap to a different
  // number of lines, so this measures every card in a row and gives them all the height of the
  // tallest. It measures the real text, so it works for any font or window width. Without JavaScript
  // the cards are simply not equalized. Opening Read more still grows only its own card.
  const captions = [...document.querySelectorAll<HTMLElement>('.gallery .piece > figcaption')];

  const equalize = () => {
    for (const caption of captions) caption.style.minHeight = '';
    const rows = new Map<number, HTMLElement[]>();
    for (const caption of captions) {
      const top = Math.round(caption.closest('.piece')!.getBoundingClientRect().top + window.scrollY);
      rows.set(top, [...(rows.get(top) ?? []), caption]);
    }
    for (const row of rows.values()) {
      if (row.length < 2) continue;
      const tallest = Math.max(...row.map((caption) => caption.getBoundingClientRect().height));
      for (const caption of row) caption.style.minHeight = `${tallest}px`;
    }
  };

  if (captions.length) {
    equalize();
    window.addEventListener('resize', equalize);
    // The text can change size once the page's fonts have loaded.
    document.fonts?.ready.then(equalize);
    // A change in the gallery's width (a new column count) changes which cards share a row.
    let width = 0;
    new ResizeObserver(([entry]) => {
      if (Math.round(entry.contentRect.width) === width) return;
      width = Math.round(entry.contentRect.width);
      equalize();
    }).observe(document.querySelector('.gallery')!);
  }
</script>

<script>
  // Click an image to see a larger version filling the page, with an X to close it. Without
  // JavaScript each image is a plain link to the larger version. The dialog is built on first use
  // so the page carries no empty image until a visitor asks for one. It is a native modal dialog,
  // which brings the Escape key, focus handling, and a backdrop with it.
  let dialog: HTMLDialogElement | null = null;
  let picture: HTMLImageElement | null = null;

  const build = () => {
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';

    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'lightbox-close';
    close.setAttribute('aria-label', 'Close larger view');
    close.innerHTML =
      '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>';
    close.addEventListener('click', () => dialog!.close());

    picture = document.createElement('img');
    picture.decoding = 'async';

    dialog.append(close, picture);
    // A click on the dark area around the picture (the dialog itself) also closes it.
    // The picture element fills the window, but the picture inside it is letterboxed, so a click
    // on the empty margin of the element counts as a click outside the picture.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) return dialog!.close();
      if (event.target !== picture || !picture!.naturalWidth) return;
      const box = picture!.getBoundingClientRect();
      const scale = Math.min(box.width / picture!.naturalWidth, box.height / picture!.naturalHeight);
      const w = picture!.naturalWidth * scale;
      const h = picture!.naturalHeight * scale;
      const left = box.left + (box.width - w) / 2;
      const top = box.top + (box.height - h) / 2;
      const inside = event.clientX >= left && event.clientX <= left + w && event.clientY >= top && event.clientY <= top + h;
      if (!inside) dialog!.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      picture!.removeAttribute('src');
    });
    document.body.append(dialog);
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')) {
    link.addEventListener('click', (event) => {
      // Let a modified click (new tab, new window) behave as a normal link.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      if (!dialog || !picture) build();
      picture!.alt = link.querySelector('img')?.alt ?? '';
      picture!.src = link.href;
      dialog!.setAttribute('aria-label', `Larger view: ${link.dataset.title ?? 'artwork'}`);
      document.documentElement.style.overflow = 'hidden';
      dialog!.showModal();
    });
  }
</script>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .lead,
  .empty {
    margin: 0 0 1.75rem;
    color: var(--muted);
  }

  .statement {
    max-width: 42rem;
    margin: 0 0 1.75rem;
  }

  .statement p {
    margin: 0 0 0.9rem;
  }

  .group {
    margin-top: 2rem;
  }

  h2 {
    margin: 0 0 0.9rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Each card keeps its image's real proportions. align-items: start means opening one
     piece's story grows only that card and does not stretch its neighbours. */
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 1.25rem;
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .piece {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: var(--card);
    overflow: hidden;
  }

  .piece :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* An image is a link to its larger version. */
  .zoom {
    display: block;
    line-height: 0;
    border: 0;
    cursor: zoom-in;
  }

  /* Every flyer sits whole in the same 4:5 frame on a soft mat, so the squares and the posters line
     up in rows. Nothing is cropped: object-fit: contain shows the whole flyer inside the frame. */
  .piece > .zoom {
    position: relative;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--fg) 6%, var(--card));
  }

  .piece > .zoom :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .zoom:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  /* The larger view is added by the script, so its styles are global. */
  :global(dialog.lightbox) {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  :global(dialog.lightbox)::backdrop {
    background: rgb(0 0 0 / 0.92);
  }

  :global(dialog.lightbox img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(.lightbox-close) {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.65);
    color: #fff;
    cursor: pointer;
  }

  :global(.lightbox-close:hover) {
    background: rgb(0 0 0 / 0.9);
    border-color: #fff;
  }

  :global(.lightbox-close:focus-visible) {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
  }

  /* The title and date block is made the same height across a row by the script below, which
     measures the real text rather than guessing how many lines a title needs in any given font. */
  .piece > figcaption .meta {
    min-height: 1.55em;
  }

  /* A card without a Read more keeps the space one would take, so it is as tall as its neighbours.
     An opened Read more still grows only its own card. */
  .read-more-space,
  .piece > details {
    min-height: 2.25rem;
  }

  .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .caption {
    font-size: 0.95rem;
  }

  details {
    padding: 0 0.9rem 0.75rem;
  }

  summary {
    cursor: pointer;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  details p {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }

  /* Further images in a series: a small grid inside the open details. */
  .more {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .more figure {
    margin: 0;
  }

  .more :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
  }

  .more figcaption {
    padding: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
