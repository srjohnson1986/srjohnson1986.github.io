---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveFilters, { type Facet } from '../../components/ArchiveFilters.astro';
import { getProjects, getFacets, tagLabel, TYPE_LABELS } from '../../lib/projects';
import { site } from '../../data/site';

const projects = await getProjects();
const facets = getFacets(projects);

const filterFacets: Facet[] = [
  {
    kind: 'select',
    name: 'year',
    label: 'Year',
    allLabel: 'All years',
    options: facets.years.map((year) => ({ value: String(year), label: String(year) })),
  },
  {
    kind: 'select',
    name: 'type',
    label: 'Type',
    allLabel: 'All types',
    options: facets.types.map((t) => ({ value: t.type, label: `${t.label} (${t.count})` })),
  },
  {
    kind: 'tags',
    name: 'tag',
    legend: 'Tags (a project must have every tag you pick)',
    options: facets.tags.map((t) => ({ value: t.tag, label: `${t.label} (${t.count})` })),
  },
];
---

<BaseLayout
  title={`Development | ${site.name}`}
  description="Every software project I have built: apps, tools, and sites, with the problem, the build, the stack, and the outcome."
>
  <h1>Development</h1>
  <p class="lead">
    Every software project I have built, newest first. Each one has its own page with the
    problem, what I built, the stack, the outcome, and links to the code.
  </p>

  <ArchiveFilters
    facets={filterFacets}
    noun="projects"
    emptyMessage="No projects match these filters. Try removing one."
  >
    <ul class="project-list">
      {
        projects.map((project) => (
          <li
            class="project"
            data-item
            data-year={project.data.year}
            data-type={project.data.type}
            data-tag={project.data.tags.join(' ')}
          >
            <h2>
              <a href={`/development/${project.id}/`}>{project.data.title}</a>
            </h2>
            <p class="meta">
              {project.data.year} &middot; {TYPE_LABELS[project.data.type]}
              {project.data.featured && <span class="featured">Featured</span>}
            </p>
            <p>{project.data.summary}</p>
            <ul class="chips">
              {project.data.tags.map((tag) => <li class="chip">{tagLabel(tag)}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </ArchiveFilters>
</BaseLayout>

<style>
  h1 {
    margin: 0 0 0.5rem;
    font-size: 2rem;
  }

  .lead {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .project-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    padding: 1rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: var(--card);
  }

  .project h2 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
  }

  .project p {
    margin: 0 0 0.6rem;
  }

  .project .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .featured {
    margin-left: 0.6rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
